gt;Privacy Platform (PbD)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;dashPattern=4 4;fillColor=#f9fbff;strokeColor=#6c8ebf;fontColor=#1f3d7a;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="1220" height="210" as="geometry"/></mxCell><mxCell id="c_cons" value='&lt;b style="font-size:13px"&gt;Consent Service&lt;/b&gt;&lt;br&gt;[Container: Java]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;согласия по целям, отзыв&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="d_cons" value='&lt;b style="font-size:13px"&gt;Consent DB&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;реестр согласий&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_tok" value='&lt;b style="font-size:13px"&gt;Tokenization Service&lt;/b&gt;&lt;br&gt;[Container: Java]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;patient_token, order_id&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_vault" value='&lt;b style="font-size:13px"&gt;Vault / KMS&lt;/b&gt;&lt;br&gt;[OpenBao / HashiCorp Vault]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Transit, PKI, ключи по доменам&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_ret" value='&lt;b style="font-size:13px"&gt;Retention &amp;amp; Erasure Job&lt;/b&gt;&lt;br&gt;[K8s CronJob]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;сроки по тегам ret, удаление&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1140" width="200" height="110" as="geometry"/></mxCell><mxCell id="b_sec" value="&lt;b&gt;Security Monitoring (PbD)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;dashPattern=4 4;fillColor=#f9fbff;strokeColor=#6c8ebf;fontColor=#1f3d7a;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="1310" y="1090" width="1150" height="210" as="geometry"/></mxCell><mxCell id="c_audit" value='&lt;b style="font-size:13px"&gt;Audit Collector&lt;/b&gt;&lt;br&gt;[Fluent Bit / Vector]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;аудит-события всех контейнеров, маскирование ПДн&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="d_siem" value='&lt;b style="font-size:13px"&gt;SIEM / UEBA&lt;/b&gt;&lt;br&gt;[Elastic Security / Wazuh]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;аудит доступа, аномалии&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1580" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_vm" value='&lt;b style="font-size:13px"&gt;VictoriaMetrics + vmalert&lt;/b&gt;&lt;br&gt;[Alertmanager]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;оповещения о НСД и нарушениях&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1830" y="1140" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_dlp" value='&lt;b style="font-size:13px"&gt;DLP&lt;/b&gt;&lt;br&gt;[InfoWatch / Solar Dozor]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;USB, почта, печать&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2080" y="1140" width="200" height="110" as="geometry"/></mxCell><mxCell id="b_dg" value="&lt;b&gt;Аналитический слой с учетом Privacy by Design + Data Governance&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;dashPattern=4 4;fillColor=#f9fbff;strokeColor=#6c8ebf;fontColor=#1f3d7a;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="2400" height="540" as="geometry"/></mxCell><mxCell id="c_cdc" value='&lt;b style="font-size:13px"&gt;CDC / Ingestion&lt;/b&gt;&lt;br&gt;[Debezium + Apache NiFi]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;только поля из allow-list&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_cls" value='&lt;b style="font-size:13px"&gt;Classification Engine&lt;/b&gt;&lt;br&gt;[Container: Python / Spark]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;теги до загрузки (Task6)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="d_raw" value='&lt;b style="font-size:13px"&gt;L1 Raw / Restricted&lt;/b&gt;&lt;br&gt;[S3 (MinIO), шифрование]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;доступ только ETL, cls:C2-C3&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_pseudo" value='&lt;b style="font-size:13px"&gt;Pseudonymizer&lt;/b&gt;&lt;br&gt;[Spark / dbt]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;токены, маски&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="d_cur" value='&lt;b style="font-size:13px"&gt;L2 Curated&lt;/b&gt;&lt;br&gt;[ClickHouse]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;псевдонимы, row/column policy&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_anon" value='&lt;b style="font-size:13px"&gt;Anonymizer&lt;/b&gt;&lt;br&gt;[Spark / ARX]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;k-anonymity, агрегаты&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="d_mart" value='&lt;b style="font-size:13px"&gt;L3 Marts&lt;/b&gt;&lt;br&gt;[ClickHouse]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;обезличенные витрины&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1580" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_bi" value='&lt;b style="font-size:13px"&gt;BI&lt;/b&gt;&lt;br&gt;[Apache Superset / DataLens]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;дашборды&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1830" y="1390" width="220" height="110" as="geometry"/></mxCell><mxCell id="c_ml" value='&lt;b style="font-size:13px"&gt;ML / LLM Sandbox&lt;/b&gt;&lt;br&gt;[JupyterHub, MLflow]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;обезличенные / синтетические&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2080" y="1390" width="200" height="110" as="geometry"/></mxCell><mxCell id="c_cat" value='&lt;b style="font-size:13px"&gt;Data Catalog + Lineage&lt;/b&gt;&lt;br&gt;[OpenMetadata]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;теги, владельцы, lineage&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="1580" width="470" height="110" as="geometry"/></mxCell><mxCell id="c_ci" value='&lt;b style="font-size:13px"&gt;Release Data Check&lt;/b&gt;&lt;br&gt;[GitLab CI: Spectral, Semgrep]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;релиз блокируется при нарушении правил тегов&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="1580" width="470" height="110" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Аналитический слой: как обеспечивается Privacy by Design&lt;/b&gt;&lt;br&gt;1. Data Minimization на входе: CDC забирает только поля из allow-list каталога, остальные отбрасываются.&lt;br&gt;2. Classification Engine размечает каждую колонку до загрузки в L1 (структуры меняются, разметки нет).&lt;br&gt;3. L1 Raw / Restricted: зашифрован, доступ только сервисным учетным записям ETL, ограниченный срок хранения.&lt;br&gt;4. L2 Curated: прямые идентификаторы заменены токенами (HMAC), C3 - только по заявке и с аудитом.&lt;br&gt;5. L3 Marts: только обезличенные и агрегированные данные (k &amp;gt;= 5) - доступны BI, ML и LLM.&lt;br&gt;6. Lineage в каталоге: по запросу субъекта данные находятся и удаляются во всех слоях.&lt;br&gt;7. Все запросы к L2/L3 пишутся в SIEM; выгрузка ПДн на ПК запрещена (DLP)." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1330" y="1560" width="1110" height="290" as="geometry"/></mxCell><mxCell id="a1" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_pat" target="c_app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_pat" target="c_web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_rec" target="c_rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="[HTTPS + MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_doc" target="c_emp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_app" target="c_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_web" target="c_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.88;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_rec" target="c_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_emp" target="c_gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="470"/><mxPoint x="580" y="470"/><mxPoint x="580" y="533"/></Array></mxGeometry></mxCell><mxCell id="g4" value="[OIDC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c_gw" target="c_kc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c_kc" target="c_opa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="[mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_gw" target="c_pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="[mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;end