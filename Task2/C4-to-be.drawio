<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="C4 Context (To-Be)" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='C4 Level 1. Контекст целевой системы "Медикаменте" (MVP -&amp;gt; Target) с блоками Privacy by Design' style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="legend" value='Обозначения:&lt;br&gt;синий - система / контейнер "Медикаменте"&lt;br&gt;зеленый - блок Privacy by Design (новый)&lt;br&gt;серый - внешняя система / внешний пользователь&lt;br&gt;MVP - промежуточное состояние (через 2 мес.)&lt;br&gt;Target - финальное состояние (через год)&lt;br&gt;пунктир - асинхронное взаимодействие / метаданные&lt;br&gt;cls:C2/C3 - класс конфиденциальности данных' style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2050" y="20" width="400" height="140" as="geometry"/></mxCell><mxCell id="u_pat" value='&lt;b style="font-size:13px"&gt;Пациент&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Записывается, оплачивает, видит только свои данные&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#6C6477;strokeColor=#4D4D57;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="170" height="160" as="geometry"/></mxCell><mxCell id="u_rec" value='&lt;b style="font-size:13px"&gt;Сотрудник ресепшена&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Запись и договоры своего филиала&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="170" height="160" as="geometry"/></mxCell><mxCell id="u_doc" value='&lt;b style="font-size:13px"&gt;Врач&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Медкарты своих пациентов&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="170" height="160" as="geometry"/></mxCell><mxCell id="u_cash" value='&lt;b style="font-size:13px"&gt;Кассир&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Оплата на кассе&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="170" height="160" as="geometry"/></mxCell><mxCell id="u_acc" value='&lt;b style="font-size:13px"&gt;Бухгалтер / кладовщик&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Учет в 1С&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1320" y="90" width="170" height="160" as="geometry"/></mxCell><mxCell id="b_sys" value="&lt;b&gt;Медикаменте - целевая платформа&lt;/b&gt;&lt;br&gt;[Software System Boundary, Kubernetes, ЦОД в РФ]" style="rounded=1;arcSize=3;absoluteArcSize=0;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1950" height="960" as="geometry"/></mxCell><mxCell id="s_client" value='&lt;b style="font-size:13px"&gt;Клиентский портал и мобильное приложение&lt;/b&gt;&lt;br&gt;[MVP: Web; Target: iOS/Android]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;ЛК пациента: запись, оплата, результаты, согласия&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_rec" value='&lt;b style="font-size:13px"&gt;Портал ресепшена&lt;/b&gt;&lt;br&gt;[MVP: Web]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Расписание, запись, напоминания, договоры&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_emp" value='&lt;b style="font-size:13px"&gt;Портал сотрудника&lt;/b&gt;&lt;br&gt;[Target: Web]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Медкарта (EMR), касса, отчеты&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_gw" value='&lt;b style="font-size:13px"&gt;API Gateway (внешний и партнерский)&lt;/b&gt;&lt;br&gt;[PbD: единая точка входа]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;OIDC/OAuth2, mTLS, валидация схем, удаление полей share:none, rate limit, защита от BOLA/IDOR&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#2D7D46;strokeColor=#1E5730;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="540" width="850" height="110" as="geometry"/></mxCell><mxCell id="s_iam" value='&lt;b style="font-size:13px"&gt;IAM&lt;/b&gt;&lt;br&gt;[PbD: Keycloak + OPA]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;SSO, MFA, RBAC + ABAC (филиал, лечащий врач, владелец данных)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#2D7D46;strokeColor=#1E5730;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1030" y="540" width="250" height="110" as="geometry"/></mxCell><mxCell id="s_core" value='&lt;b style="font-size:13px"&gt;Медицинская платформа&lt;/b&gt;&lt;br&gt;[MVP: Patient, Appointment; Target: EMR]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Домены: пациент (C2), запись (C2), медкарта (C3 PHI)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_pay" value='&lt;b style="font-size:13px"&gt;Платежный шлюз&lt;/b&gt;&lt;br&gt;[Target]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Счета, онлайн-оплата, фискализация&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="760" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_crm" value='&lt;b style="font-size:13px"&gt;CRM&lt;/b&gt;&lt;br&gt;[Target]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Коммуникации по согласию: только токен + контакт&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_notif" value='&lt;b style="font-size:13px"&gt;Сервис уведомлений&lt;/b&gt;&lt;br&gt;[MVP: SMS/Push; Target: голосовой робот]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Напоминания без медсведений, подтверждение / отмена&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="760" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_1c" value='&lt;b style="font-size:13px"&gt;1С: Бухгалтерия, Торговля и склад&lt;/b&gt;&lt;br&gt;[Legacy -&amp;gt; клиент-сервер]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Проводки без медсведений&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1280" y="760" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_lab" value='&lt;b style="font-size:13px"&gt;Интеграция с лабораторией&lt;/b&gt;&lt;br&gt;[Target]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Псевдонимизированные заказы и результаты&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1580" y="760" width="250" height="120" as="geometry"/></mxCell><mxCell id="s_priv" value='&lt;b style="font-size:13px"&gt;Privacy Platform&lt;/b&gt;&lt;br&gt;[PbD: Consent + Tokenization + Vault/KMS]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Согласия по целям, отзыв -&amp;gt; остановка обработки; токенизация ПДн; ключи шифрования, crypto-shredding&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#2D7D46;strokeColor=#1E5730;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="360" height="140" as="geometry"/></mxCell><mxCell id="s_gov" value='&lt;b style="font-size:13px"&gt;Data Governance&lt;/b&gt;&lt;br&gt;[PbD: Data Catalog, Classification, Lineage]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Теги cls/cat/purpose/ret, автоклассификация, проверка релизов на работу с тегированными данными&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#2D7D46;strokeColor=#1E5730;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="1010" width="360" height="140" as="geometry"/></mxCell><mxCell id="s_secmon" value='&lt;b style="font-size:13px"&gt;Security Monitoring&lt;/b&gt;&lt;br&gt;[PbD: Audit Log, SIEM/UEBA, DLP, алертинг]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Аудит-события всех блоков; нетипичные действия; оповещения о НСД&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#2D7D46;strokeColor=#1E5730;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="1010" width="360" height="140" as="geometry"/></mxCell><mxCell id="s_dp" value='&lt;b style="font-size:13px"&gt;Аналитическая платформа (Privacy-aware)&lt;/b&gt;&lt;br&gt;[PbD: Raw -&amp;gt; Curated -&amp;gt; Marts]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Классификация на входе, псевдонимизация, обезличивание; BI / ML / LLM только на обезличенных данных&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#2D7D46;strokeColor=#1E5730;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1400" y="1010" width="430" height="140" as="geometry"/></mxCell><mxCell id="u_sec" value='&lt;b style="font-size:13px"&gt;Офицер ИБ / DPO&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Аудит, инциденты, запросы субъектов&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1055" y="1300" width="170" height="160" as="geometry"/></mxCell><mxCell id="u_ba" value='&lt;b style="font-size:13px"&gt;Аналитик / Data Scientist&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;BI, ML на обезличенных данных&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1530" y="1300" width="170" height="160" as="geometry"/></mxCell><mxCell id="x_acq" value='&lt;b style="font-size:13px"&gt;Банк-эквайер&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Платежная страница, токены карт&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2130" y="340" width="250" height="110" as="geometry"/></mxCell><mxCell id="x_ofd" value='&lt;b style="font-size:13px"&gt;ОФД / ФНС&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Фискальные чеки&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2130" y="530" width="250" height="110" as="geometry"/></mxCell><mxCell id="x_lab" value='&lt;b style="font-size:13px"&gt;Лаборатория&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;API партнера&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2130" y="765" width="250" height="110" as="geometry"/></mxCell><mxCell id="x_sms" value='&lt;b style="font-size:13px"&gt;Провайдер SMS / Push /&lt;br&gt;голосового робота&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Оператор в РФ&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2130" y="1000" width="250" height="110" as="geometry"/></mxCell><mxCell id="x_bank" value='&lt;b style="font-size:13px"&gt;Банк / оператор ЭДО&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;ДиректБанк, отчетность&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2130" y="1200" width="250" height="110" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Как блоки Privacy by Design закрывают принципы PbD&lt;/b&gt;&lt;br&gt;1. Проактивность: Data Governance классифицирует данные до загрузки и блокирует релизы, работающие с нетегированными данными.&lt;br&gt;2. Конфиденциальность по умолчанию: API Gateway отдает только поля, разрешенные тегами; новые поля - C3 до проверки; ABAC в IAM.&lt;br&gt;3. Встроенность в дизайн: домены данных разделены, на границах доменов ПДн заменяются токенами (Privacy Platform).&lt;br&gt;4. Полная функциональность: запись, оплата, результаты и аналитика работают на токенах и обезличенных данных.&lt;br&gt;5. Защита на всем жизненном цикле: TLS/mTLS in transit, шифрование at rest (Vault/KMS), сроки хранения по тегам, crypto-shredding.&lt;br&gt;6. Прозрачность: аудит каждого доступа к C3, Lineage показывает путь данных, пациент видит свои согласия.&lt;br&gt;7. Уважение к пользователю: Consent Service, отзыв согласия -&amp;gt; прекращение обработки и удаление во всех слоях (152-ФЗ ст. 21).&lt;br&gt;MVP: клиентский портал, портал ресепшена, Patient + Appointment, уведомления, API Gateway, IAM (RBAC/ABAC), Consent + Tokenization + Vault, Audit Log.&lt;br&gt;Target: мобильное приложение, EMR, платежи, CRM, лаборатория, голосовой робот, Data Governance с проверкой релизов, SIEM/UEBA/DLP, аналитическая платформа." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="1950" height="230" as="geometry"/></mxCell><mxCell id="r1" value='Запись, оплата, свои результаты&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u_pat" target="s_client"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value='Запись, договоры&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_rec" target="s_rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3" value='Медкарта&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS + MFA]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_doc" target="s_emp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4" value='Касса&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS + MFA]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_cash" target="s_emp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value='Учет&lt;br&gt;&lt;font color="#555555"&gt;[VDI]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_acc" target="s_1c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r6" value='BI, ML&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS, RBAC]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_ba" target="s_dp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7" value='Расследования, отчеты&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_sec" target="s_secmon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r8" value="[REST/JSON, TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_client" target="s_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r9" value="[REST, TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_rec" target="s_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r10" value="[REST, TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_emp" target="s_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r11" value='Токены, решения&lt;br&gt;&lt;font color="#555555"&gt;[OIDC]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s_gw" target="s_iam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r12" value="[mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_gw" target="s_core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r13" value="[mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_gw" target="s_pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r14" value="[mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_gw" target="s_crm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r17" value='Redirect, статус оплаты&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pay" target="x_acq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="690"/><mxPoint x="2070" y="690"/><mxPoint x="2070" y="395"/></Array></mxGeometry></mxCell><mxCell id="r18" value='Чек (обобщенно)&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pay" target="x_ofd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="555" y="715"/><mxPoint x="2050" y="715"/><mxPoint x="2050" y="585"/></Array></mxGeometry></mxCell><mxCell id="r16" value='order_id, коды тестов&lt;br&gt;&lt;font color="#555555"&gt;[mTLS + OAuth2]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s_lab" target="x_lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r19" value='Шаблон без медсведений&lt;br&gt;&lt;font color="#555555"&gt;[HTTPS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_notif" target="x_sms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1105" y="940"/><mxPoint x="2070" y="940"/><mxPoint x="2070" y="1055"/></Array></mxGeometry></mxCell><mxCell id="r20" value='Реестры, отчеты&lt;br&gt;&lt;font color="#555555"&gt;[ДиректБанк, ЭДО + УКЭП]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_1c" target="x_bank"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1455" y="965"/><mxPoint x="2050" y="965"/><mxPoint x="2050" y="1255"/></Array></mxGeometry></mxCell><mxCell id="r21" value='События (только токены)&lt;br&gt;&lt;font color="#555555"&gt;[Kafka]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_core" target="s_notif"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="905"/><mxPoint x="1055" y="905"/></Array></mxGeometry></mxCell><mxCell id="r22" value="[Kafka]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_core" target="s_lab"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="292" y="920"/><mxPoint x="1705" y="920"/></Array></mxGeometry></mxCell><mxCell id="r23" value='Проводки&lt;br&gt;&lt;font color="#555555"&gt;[Accounting Adapter]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pay" target="s_1c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="952"/><mxPoint x="1355" y="952"/></Array></mxGeometry></mxCell><mxCell id="r15" value='Токены, шифрование PHI&lt;br&gt;&lt;font color="#555555"&gt;[gRPC/mTLS]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_core" target="s_priv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r24" value='CDC (только разрешенные поля)&lt;br&gt;&lt;font color="#555555"&gt;[Debezium / NiFi]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_core" target="s_dp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="820"/><mxPoint x="60" y="1175"/><mxPoint x="1658" y="1175"/></Array></mxGeometry></mxCell><mxCell id="r25" value="Теги, классификация" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_gov" target="s_dp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1200"/><mxPoint x="1529" y="1200"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="C4 Container (To-Be)" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='C4 Level 2. Контейнеры целевой платформы "Медикаменте": домены данных и блоки Privacy by Design' style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="legend" value='Обозначения:&lt;br&gt;синий - система / контейнер "Медикаменте"&lt;br&gt;зеленый - блок Privacy by Design (новый)&lt;br&gt;серый - внешняя система / внешний пользователь&lt;br&gt;MVP - промежуточное состояние (через 2 мес.)&lt;br&gt;Target - финальное состояние (через год)&lt;br&gt;пунктир - асинхронное взаимодействие / метаданные&lt;br&gt;cls:C2/C3 - класс конфиденциальности данных' style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2540" y="20" width="400" height="140" as="geometry"/></mxCell><mxCell id="u_pat" value='&lt;b style="font-size:13px"&gt;Пациент&lt;/b&gt;&lt;br&gt;[Person]' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#6C6477;strokeColor=#4D4D57;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="160" height="150" as="geometry"/></mxCell><mxCell id="u_rec" value='&lt;b style="font-size:13px"&gt;Ресепшен&lt;/b&gt;&lt;br&gt;[Person]' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="160" height="150" as="geometry"/></mxCell><mxCell id="u_doc" value='&lt;b style="font-size:13px"&gt;Врач / кассир&lt;/b&gt;&lt;br&gt;[Person]' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="160" height="150" as="geometry"/></mxCell><mxCell id="u_ba" value='&lt;b style="font-size:13px"&gt;Аналитик&lt;/b&gt;&lt;br&gt;[Person]' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2140" y="90" width="160" height="150" as="geometry"/></mxCell><mxCell id="bnd" value="&lt;b&gt;Медикаменте - целевая платформа&lt;/b&gt;&lt;br&gt;[Container boundary]" style="rounded=1;arcSize=3;absoluteArcSize=0;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="2460" height="1640" as="geometry"/></mxCell><mxCell id="c_app" value='&lt;b style="font-size:13px"&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;[Container: Kotlin / Swift]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Target: ЛК, push&lt;/font&gt;' style="whiteSpace=wrap;