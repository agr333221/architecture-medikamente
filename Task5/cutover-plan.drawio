<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="Cutover Parallel run" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='Cutover-план миграции "Медикаменте": стратегия Parallel run (пилотный филиал -&amp;gt; волны филиалов)' style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Старт&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520.0" y="90" width="120" height="50" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Этап 0. Подготовка (недели 1-4)&lt;/b&gt;&lt;br&gt;Кластер Kubernetes, БД, Kafka, IAM, Vault, наблюдаемость (SLO, baseline As-Is), CI/CD;&lt;br&gt;очистка и дедупликация Excel; согласия, модель угроз; обучение ключевых пользователей" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="560" height="110" as="geometry"/></mxCell><mxCell id="e_s0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="&lt;b&gt;Этап 1. Начальная миграция данных (недели 5-6)&lt;/b&gt;&lt;br&gt;Загрузка справочников, пациентов (MPI), будущих записей из журналов;&lt;br&gt;автоматическая сверка количества и контрольных сумм; шифрование и теги" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;Этап 2. Тестирование (недели 5-8)&lt;/b&gt;&lt;br&gt;Функциональные, интеграционные (1С, уведомления), нагрузочные (5x),&lt;br&gt;тесты безопасности и ПДн, UAT с ресепшеном и врачами, репетиция отката" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="485" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g1" value="Готовы к&lt;br&gt;параллельной&lt;br&gt;работе?" style="whiteSpace=wrap;html=1;fontSize=11;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490.0" y="630" width="180" height="120" as="geometry"/></mxCell><mxCell id="e_g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;Этап 3. Parallel run - shadow (недели 9-10)&lt;/b&gt;&lt;br&gt;Пилотный филиал: Excel остается основным, новая система работает параллельно;&lt;br&gt;двойной ввод записей (или CDC/импорт), ежедневная автоматическая сверка, разбор расхождений" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="790" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s3" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="Расхождения&lt;br&gt;&amp;lt; 0,5 %, SLO&lt;br&gt;выполняются?" style="whiteSpace=wrap;html=1;fontSize=11;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490.0" y="935" width="180" height="120" as="geometry"/></mxCell><mxCell id="e_g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;Этап 4. Parallel run - new primary (недели 11-12)&lt;/b&gt;&lt;br&gt;Новая система - основной источник; Excel формируется выгрузкой только для чтения (резерв);&lt;br&gt;открывается онлайн-запись для клиентов пилотного филиала, напоминания из системы" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="1095" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s4" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g3" value="Go / No-Go&lt;br&gt;на cutover?" style="whiteSpace=wrap;html=1;fontSize=11;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490.0" y="1240" width="180" height="120" as="geometry"/></mxCell><mxCell id="e_g3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;Этап 5. Cutover (выходные, окно 8 ч)&lt;/b&gt;&lt;br&gt;Заморозка Excel (read-only), финальная дельта и сверка, переключение ресепшена, касс и&lt;br&gt;интеграции с 1С; smoke-тесты; коммуникация сотрудникам и пациентам" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="1400" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s5" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g4" value="Smoke-тесты&lt;br&gt;и сверка&lt;br&gt;успешны?" style="whiteSpace=wrap;html=1;fontSize=11;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490.0" y="1545" width="180" height="120" as="geometry"/></mxCell><mxCell id="e_g4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;Этап 6. Hypercare и мониторинг (2-4 недели)&lt;/b&gt;&lt;br&gt;Дежурство команды, мониторинг SLO, ошибок, очередей, аудита доступа;&lt;br&gt;ежедневный разбор инцидентов; повтор этапов 3-6 волнами для новых филиалов" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="1705" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s6" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7" value="&lt;b&gt;Этап 7. Вывод старого решения&lt;/b&gt;&lt;br&gt;Архив Excel и сканов в шифрованном хранилище с ограниченным доступом и сроком хранения;&lt;br&gt;уничтожение локальных копий, отключение общих папок; закрытие проекта, lessons learned" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="1850" width="560" height="95" as="geometry"/></mxCell><mxCell id="e_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="end" value="&lt;b&gt;Финиш&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520.0" y="1995" width="120" height="50" as="geometry"/></mxCell><mxCell id="e_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rb_g1" value="&lt;b&gt;Откат R1&lt;/b&gt;&lt;br&gt;Исправление дефектов, повторное тестирование;&lt;br&gt;старый процесс (Excel) продолжает работать, влияния на пациентов нет" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="650.0" width="500" height="80" as="geometry"/></mxCell><mxCell id="e_rb_g1" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="rb_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rb_g2" value="&lt;b&gt;Откат R2&lt;/b&gt;&lt;br&gt;Остановить параллельную работу, Excel остается основным;&lt;br&gt;анализ причин расхождений, исправление синхронизации, повтор этапа 3" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="955.0" width="500" height="80" as="geometry"/></mxCell><mxCell id="e_rb_g2" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="rb_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rb_g3" value="&lt;b&gt;Откат R3&lt;/b&gt;&lt;br&gt;Вернуть Excel как основной источник: обратная выгрузка записей&lt;br&gt;из новой системы в журналы (подготовленный скрипт), уведомить ресепшен" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="1260.0" width="500" height="80" as="geometry"/></mxCell><mxCell id="e_rb_g3" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="rb_g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rb_g4" value="&lt;b&gt;Откат R4 (в окне cutover)&lt;/b&gt;&lt;br&gt;Снять заморозку Excel, применить обратную выгрузку дельты,&lt;br&gt;вернуть кассы на прежний процесс; решение - cutover manager, не позднее 4 ч окна" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="1565.0" width="500" height="80" as="geometry"/></mxCell><mxCell id="e_rb_g4" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="rb_g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_back_g1" value="повтор после&lt;br&gt;исправления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rb_g1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_back_g2" value="повтор после&lt;br&gt;исправления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rb_g2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_back_g3" value="повтор после&lt;br&gt;исправления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rb_g3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_back_g4" value="повтор после&lt;br&gt;исправления" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rb_g4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Ключевые критерии Go / No-Go&lt;/b&gt;&lt;br&gt;G1: все критичные дефекты закрыты; нагрузочный тест 5x в рамках SLO;&lt;br&gt;      пентест без критичных уязвимостей; репетиция отката выполнена.&lt;br&gt;G2: расхождения записей old/new &amp;lt; 0,5 % три дня подряд;&lt;br&gt;      p95 записи =&amp;lt; 500 мс; нет инцидентов ИБ; пользователи обучены.&lt;br&gt;G3: 5 рабочих дней без критичных инцидентов в режиме new primary;&lt;br&gt;      согласование владельцев (ресепшен, врачи, бухгалтерия, ИБ).&lt;br&gt;G4: smoke-тесты 100 %, финальная сверка без расхождений,&lt;br&gt;      интеграция с 1С и ККМ работает.&lt;br&gt;&lt;br&gt;Роли: cutover manager - технический директор;&lt;br&gt;решение No-Go может принять любой владелец критерия." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="560" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
