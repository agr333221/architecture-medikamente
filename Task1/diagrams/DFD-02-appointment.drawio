<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-02. Запись на прием и напоминание о визите (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(звонок / визит)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="170" height="70" as="geometry"/></mxCell><mxCell id="doc" value="Врач" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P2.1&lt;/b&gt;&lt;br&gt;Прием заявки&lt;br&gt;и поиск пациента" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P2.2&lt;/b&gt;&lt;br&gt;Запись в журнал врача" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="560" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P2.3&lt;/b&gt;&lt;br&gt;Напоминание о визите&lt;br&gt;(за день до приема)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="200" height="90" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Patients.xlsx&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;общий диск&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="305" width="250" height="54" as="geometry"/></mxCell><mxCell id="d5" value='&lt;b&gt;D5&lt;/b&gt;&amp;nbsp;&amp;nbsp;Journal-Doctor-FIO.xlsx&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;журнал на каждого врача&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="770" width="250" height="54" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;D3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Exchange / телефон ресепшена" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1390" y="590" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="ФИО, телефон, жалоба,&lt;br&gt;желаемый врач [PII][PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="поиск по ФИО" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="данные пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="слот, пациент" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="ФИО, телефон, время,&lt;br&gt;причина обращения [PII][PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="просмотр/правка своего&lt;br&gt;и ЛЮБОГО чужого журнала" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="doc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="список визитов на завтра" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="звонок / письмо" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="напоминание&lt;br&gt;(может содержать врача и причину)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="pat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="578"/><mxPoint x="1330" y="245"/><mxPoint x="125" y="245"/></Array></mxGeometry></mxCell><mxCell id="n10" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. Журналы по врачу в Excel: одновременная правка, конфликт версий, потеря записей (целостность).&lt;br&gt;2. Врач видит журналы всех коллег, нет разграничения по принципу need-to-know.&lt;br&gt;3. Причина обращения (данные о здоровье) хранится вместе с контактами в открытом виде.&lt;br&gt;4. Напоминания вручную: ошибки адресата, раскрытие врача/диагноза третьим лицам.&lt;br&gt;5. Нет журнала, кто открывал/менял запись; нет резервного копирования с контролем.&lt;br&gt;6. При 5x росте и нескольких филиалах ручной процесс не масштабируется." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="900" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-02. Запись на прием и напоминание о визите (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(портал / приложение)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="170" height="70" as="geometry"/></mxCell><mxCell id="rec" value="Администратор ресепшена" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="170" height="70" as="geometry"/></mxCell><mxCell id="doc" value="Врач (портал сотрудника)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="785" width="170" height="70" as="geometry"/></mxCell><mxCell id="gw" value='&lt;b&gt;P2.0&lt;/b&gt;&lt;br&gt;API Gateway + IAM&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;OIDC, RBAC/ABAC [М1]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="530" width="200" height="90" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P2.1&lt;/b&gt;&lt;br&gt;Запись на прием&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Appointment Service&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;P2.2&lt;/b&gt;&lt;br&gt;Планировщик напоминаний&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Scheduler&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value='&lt;b&gt;P2.3&lt;/b&gt;&lt;br&gt;Отправка уведомлений&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Notification Service [М4]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Appointment DB&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;patient_token, doctor_id, слот, cls:C2&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1240" y="275" width="250" height="54" as="geometry"/></mxCell><mxCell id="d2" value='&lt;b&gt;D2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Event Bus (Kafka)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;события без ПДн, только токены&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1240" y="425" width="250" height="54" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;D4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Audit Log -&amp;gt; SIEM" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1240" y="800" width="250" height="54" as="geometry"/></mxCell><mxCell id="ch" value="Push / SMS / голосовой&lt;br&gt;робот (провайдер в РФ)" style="whiteSpace=wrap;