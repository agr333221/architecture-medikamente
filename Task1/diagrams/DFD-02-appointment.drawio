try></mxCell><mxCell id="e5" value="запись визита" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="AppointmentCreated&lt;br&gt;{token, slot}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="напомнить token&lt;br&gt;за 24 ч" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="телефон/push-id (из Patient&lt;br&gt;Service по токену) + шаблон&lt;br&gt;без диагноза [М4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p3" target="ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="подтвердил / отменил" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1755" y="710"/></Array></mxGeometry></mxCell><mxCell id="e11" value="ConfirmCancel&lt;br&gt;-&amp;gt; ресепшен" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="все обращения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. Аутентификация через Keycloak; пациент - OIDC + OTP, сотрудники - MFA.&lt;br&gt;М2. ABAC: пациент видит только записи с patient_id = sub токена; врач - только свое расписание;&lt;br&gt;      ресепшен - записи своего филиала, телефон маскирован (+7 *** ***-12-34), причина обращения скрыта.&lt;br&gt;М3. Причина обращения не хранится в Appointment DB (только код услуги); анамнез - в медкарте (DFD-03).&lt;br&gt;М4. Уведомления по шаблону без медицинских сведений; контакт берется по токену в момент отправки.&lt;br&gt;М5. Event Bus передает только токены; транспорт mTLS, шифрование топиков на диске.&lt;br&gt;М6. Аудит и алерты: массовый просмотр записей, доступ вне смены, выгрузки." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="1100" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
