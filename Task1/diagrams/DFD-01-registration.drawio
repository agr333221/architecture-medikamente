<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-01. Регистрация пациента и заключение договора (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="170" height="70" as="geometry"/></mxCell><mxCell id="any" value="Любой сотрудник&lt;br&gt;домена AD" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P1.1&lt;/b&gt;&lt;br&gt;Сбор анкеты&lt;br&gt;(ресепшен, вручную)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P1.2&lt;/b&gt;&lt;br&gt;Заключение договора&lt;br&gt;и сканирование документов" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="515" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P1.3&lt;/b&gt;&lt;br&gt;Ввод пациента в реестр" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="d0" value='&lt;b&gt;D0&lt;/b&gt;&amp;nbsp;&amp;nbsp;Бумажный архив анкет&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;в шкафу ресепшена&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="680" width="250" height="54" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Patients.xlsx&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;общий диск, без шифрования&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1390" y="312" width="250" height="54" as="geometry"/></mxCell><mxCell id="d2" value='&lt;b&gt;D2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Папка Pacient-FIO-BD&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;сканы JPG/PDF, имя папки = ФИО+ДР&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1390" y="470" width="250" height="54" as="geometry"/></mxCell><mxCell id="d3" value='&lt;b&gt;D3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Exchange (почтовые ящики)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;письма с вложениями&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1390" y="620" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="ФИО, ДР, телефон, email [PII]&lt;br&gt;адрес, место работы/учебы [PII]&lt;br&gt;хронические заболевания [PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="паспорт, полис ДМС [ID]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="заполненная анкета" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="строка пациента&lt;br&gt;(все поля анкеты)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="бумажные анкета и договор" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="скан паспорта, договора,&lt;br&gt;согласия [ID][PII]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="договор по email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;" edge="1" parent="1" source="p2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="копия договора" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="чтение / копирование&lt;br&gt;(нет RBAC и аудита)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="any"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1705" y="339"/><mxPoint x="1705" y="867"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="any"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1705" y="507"/></Array></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. Нет учета согласий на обработку ПДн и данных о здоровье (152-ФЗ ст. 9, 10).&lt;br&gt;2. Сбор избыточных данных (место работы/учебы, адрес) без цели - нарушение Data Minimization.&lt;br&gt;3. Данные о здоровье (хронические заболевания) лежат в одном файле с контактами.&lt;br&gt;4. ФИО и дата рождения в именах папок - ПДн видны при просмотре каталога.&lt;br&gt;5. Файлы на общем диске без шифрования, разграничения доступа и журнала аудита.&lt;br&gt;6. Договор и сканы паспорта отправляются по почте открытым текстом.&lt;br&gt;7. Бумажный архив без учета выдачи и сроков уничтожения." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="900" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-01. Регистрация пациента и заключение договора (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(портал / приложение)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="170" height="70" as="geometry"/></mxCell><mxCell id="rec" value="Администратор ресепшена&lt;br&gt;(портал ресепшена)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="170" height="70" as="geometry"/></mxCell><mxCell id="gw" value='&lt;b&gt;P1.0&lt;/b&gt;&lt;br&gt;API Gateway + IAM&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;OIDC, MFA, RBAC/ABAC [М1]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="515" width="200" height="90" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P1.1&lt;/b&gt;&lt;br&gt;Регистрация пациента&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Patient Service (MPI)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="305" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;P1.2&lt;/b&gt;&lt;br&gt;Управление согласиями&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Consent Service [М3]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="515" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value='&lt;b&gt;P1.3&lt;/b&gt;&lt;br&gt;Электронный договор&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Contract Service, ПЭП/УКЭП&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="725" width="200" height="90" as="geometry"/></mxCell><mxCell id="tok" value='&lt;b&gt;P1.4&lt;/b&gt;&lt;br&gt;Токенизация и шифрование&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Vault / KMS [М4]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="305" width="200" height="90" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Patient DB (PostgreSQL)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;cls:C2-C3, поля PHI/ID зашифрованы&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1570" y="260" width="250" height="54" as="geometry"/></mxCell><mxCell id="d2" value='&lt;b&gt;D2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Consent Registry&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;цели, сроки, отзыв согласия&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1570" y="410" width="250" height="54" as="geometry"/></mxCell><mxCell id="d3" value='&lt;b&gt;D3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Document Store (S3, SSE)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;теги объектов cls/cat, ключ на объект&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1570" y="740" width="250" height="54" as="geometry"/></mxCell><mxCell id="d4" value='&lt;b&gt;D4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Audit Log -&amp;gt; SIEM&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;кто, что, когда, зачем [М6]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1570" y="575" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="минимальный набор: ФИО, ДР,&lt;br&gt;телефон, email [PII] [М2]&lt;br&gt;TLS 1.3 / ГОСТ TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="те же поля при визите&lt;br&gt;+ данные паспорта [ID]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="профиль пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="согласия по целям" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="gw" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="подписание договора" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="PHI, ID -&amp;gt; шифрование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p1" target="tok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="шифротекст + patient_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="tok" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="согласие, цель, срок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="PDF договора (подписан)&lt;br&gt;теги: cls:C3 cat:ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="455"/><mxPoint x="1120" y="455"/><mxPoint x="1120" y="591"/></Array></mxGeometry></mxCell><mxCell id="e11" value="события доступа" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. Единая аутентификация (Keycloak, OIDC), MFA для сотрудников; RBAC (роль ресепшена) + ABAC (филиал).&lt;br&gt;М2. Data Minimization: расширенная анкета (адрес, работа) только при наличии цели; хрон. заболевания - в медкарту (DFD-03).&lt;br&gt;М3. Согласия на обработку ПДн и данных о здоровье по каждой цели, отзыв согласия -&amp;gt; остановка обработки и удаление.&lt;br&gt;М4. Шифрование полей PHI/ID (Vault Transit), токен вместо ПДн в других сервисах; шифрование дисков и бэкапов.&lt;br&gt;М5. Документы в S3 с SSE-шифрованием и тегами cls/cat; имена объектов - UUID, без ФИО.&lt;br&gt;М6. Аудит всех операций чтения/записи ПДн в SIEM, алерты на нетипичный доступ.&lt;br&gt;М7. Теги классификации в Data Catalog (OpenMetadata) для каждой колонки D1-D3." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1100" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
