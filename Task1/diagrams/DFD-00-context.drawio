<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='DFD-00. Контекстная диаграмма потоков данных "Медикаменте" (As-Is, уровень 0)' style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="sys" value='&lt;b&gt;0&lt;/b&gt;&lt;br&gt;Процессы "Медикаменте"&lt;br&gt;(Excel, сканы, 1С, Exchange,&lt;br&gt;файловый сервер)' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="455" width="260" height="120" as="geometry"/></mxCell><mxCell id="pat" value="Пациент" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="170" height="70" as="geometry"/></mxCell><mxCell id="lab" value="Лаборатория" style="white