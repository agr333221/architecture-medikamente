belBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="бланки направлений [PII][PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="результаты анализов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="реестры зарплаты, платежи [FIN][HR]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="ввод и чтение всех данных&lt;br&gt;(без RBAC и аудита)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="emp" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="чеки, отчеты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="fns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="накладные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sup" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="&lt;b&gt;Детализация&lt;/b&gt;&lt;br&gt;DFD-01 Регистрация пациента и договор&lt;br&gt;DFD-02 Запись на прием и напоминание&lt;br&gt;DFD-03 Прием у врача и медкарта&lt;br&gt;DFD-04 Анализы и лаборатория&lt;br&gt;DFD-05 Оплата услуг&lt;br&gt;DFD-06 Бухгалтерия, кадры, зарплата&lt;br&gt;DFD-07 Учет ТМЦ и склад&lt;br&gt;DFD-08 Отчетность и аналитика" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="360" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
