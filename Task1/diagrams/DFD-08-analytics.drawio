<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-08. Отчетность и аналитика (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="ba" value="Бизнес-аналитик" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="170" height="70" as="geometry"/></mxCell><mxCell id="mgmt" value="Руководство" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="425" width="170" height="70" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1,D5,D6,D7&lt;/b&gt;&amp;nbsp;&amp;nbsp;Excel-файлы общего диска&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;пациенты, журналы, анализы, оплаты&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="300" height="54" as="geometry"/></mxCell><mxCell id="d8" value="&lt;b&gt;D8&lt;/b&gt;&amp;nbsp;&amp;nbsp;Выгрузки из 1С" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="250" height="54" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P8.1&lt;/b&gt;&lt;br&gt;Копирование файлов&lt;br&gt;на локальный ПК" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="425" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P8.2&lt;/b&gt;&lt;br&gt;Обработка в Jupyter /&lt;br&gt;Python, отчеты P&amp;amp;L, ABC" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="425" width="200" height="90" as="geometry"/></mxCell><mxCell id="loc" value='&lt;b&gt;D11&lt;/b&gt;&amp;nbsp;&amp;nbsp;Локальный диск ПК аналитика&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;полные копии ПДн&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="полные файлы [PII][PHI][FIN]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="выгрузки [FIN][HR]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="662"/><mxPoint x="445" y="497"/></Array></mxGeometry></mxCell><mxCell id="e3" value="запуск" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ba" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="копии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="loc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="данные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="loc" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="отчеты Excel по email&lt;br&gt;(могут содержать ФИО)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p2" target="mgmt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n7" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. Полные копии ПДн и данных о здоровье на локальном ПК, без шифрования и учета.&lt;br&gt;2. Нет обезличивания перед анализом; нет разделения на слои raw / curated / marts.&lt;br&gt;3. Нет Data Lineage: невозможно понять, откуда взялась цифра в отчете и где копии данных.&lt;br&gt;4. Ручная подготовка данных не позволяет строить BI, ML и LLM-сервисы (цель бизнеса N2).&lt;br&gt;5. Отчеты пересылаются по почте, нет контроля распространения." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="900" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-08. Аналитическая платформа с учетом Privacy by Design (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1530" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;S&lt;/b&gt;&amp;nbsp;&amp;nbsp;Операционные БД (Patient,&lt;br&gt;EMR, Appointment, Payment, 1С)" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="260" height="70" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P8.1&lt;/b&gt;&lt;br&gt;Загрузка (CDC / NiFi)&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;только разрешенные поля [М1]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;P8.2&lt;/b&gt;&lt;br&gt;Движок классификации&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;теги cls/cat, см. Task6 [М2]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="raw" value='&lt;b&gt;L1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Raw / Restricted zone&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;шифрование, доступ - только ETL&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="275" width="250" height="54" as="geometry"/></mxCell><mxCell id="p3" value='&lt;b&gt;P8.3&lt;/b&gt;&lt;br&gt;Псевдонимизация /&lt;br&gt;маскирование&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;[М3]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="cur" value='&lt;b&gt;L2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Curated (псевдонимы)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;ClickHouse, row/column policy&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="365" width="250" height="54" as="geometry"/></mxCell><mxCell id="p4" value='&lt;b&gt;P8.4&lt;/b&gt;&lt;br&gt;Обезличивание&lt;br&gt;(k-anonymity, агрегаты)&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;[М4]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="mart" value='&lt;b&gt;L3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Data Marts (обезличенные)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;BI, ML, LLM&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1600" y="530" width="250" height="54" as="geometry"/></mxCell><mxCell id="ba" value="Аналитик / Data Scientist" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1630" y="290" width="170" height="70" as="geometry"/></mxCell><mxCell id="mgmt" value="Руководство (BI)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1630" y="725" width="170" height="70" as="geometry"/></mxCell><mxCell id="cat" value='&lt;b&gt;MD&lt;/b&gt;&amp;nbsp;&amp;nbsp;Data Catalog + Lineage&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;OpenMetadata: теги, владельцы&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="изменения (CDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="записи" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="размеченные данные&lt;br&gt;TLS, шифрование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="raw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="C2-C3 поля" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="raw" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="токены вместо ФИО" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="cur"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="данные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="агрегаты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="mart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="по заявке, RBAC [М5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur" target="ba"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="дашборды" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mart" target="mgmt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="теги, схема" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="cat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="lineage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="cat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. Data Minimization на входе: в озеро попадают только поля, нужные для заявленных целей аналитики.&lt;br&gt;М2. Автоматическая классификация каждой новой колонки (схемы меняются) и регистрация тегов в каталоге.&lt;br&gt;М3. Прямые идентификаторы заменяются токенами (HMAC с ключом из Vault); таблица соответствия - только в L1.&lt;br&gt;М4. В витринах - только обезличенные/агрегированные данные (k &amp;gt;= 5), для ML - синтетические или обезличенные выборки.&lt;br&gt;М5. Доступ по ролям Keycloak, column/row policies ClickHouse, аудит запросов, запрет выгрузок ПДн на ПК.&lt;br&gt;М6. Lineage в OpenMetadata: путь каждого показателя от источника до отчета, удаление по запросу субъекта во всех слоях." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1200" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
