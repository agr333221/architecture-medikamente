<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-06. Бухгалтерия, кадровый учет и зарплата (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="emp" value="Сотрудник" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="170" height="70" as="geometry"/></mxCell><mxCell id="bank" value="Банк&lt;br&gt;(зарплатный проект)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="275" width="170" height="70" as="geometry"/></mxCell><mxCell id="fns" value="ФНС / СФР" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="590" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P6.1&lt;/b&gt;&lt;br&gt;Прием на работу,&lt;br&gt;кадровый учет" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="410" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P6.2&lt;/b&gt;&lt;br&gt;Начисление зарплаты" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="275" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P6.3&lt;/b&gt;&lt;br&gt;Налоговая и&lt;br&gt;социальная отчетность" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="d8" value='&lt;b&gt;D8&lt;/b&gt;&amp;nbsp;&amp;nbsp;1С:Бухгалтерия (.1CD)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;общий диск, файловый режим&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="740" width="250" height="54" as="geometry"/></mxCell><mxCell id="dx" value='&lt;b&gt;D9&lt;/b&gt;&amp;nbsp;&amp;nbsp;Выгрузки Excel / сканы&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;кадровые документы на диске&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="822" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="паспорт, СНИЛС, ИНН, адрес,&lt;br&gt;реквизиты карты [ID][HR][FIN]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="emp" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="личная карточка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="сканы документов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="dx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="482"/><mxPoint x="430" y="849"/></Array></mxGeometry></mxCell><mxCell id="e4" value="оклады, табель" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="реестр на зарплату&lt;br&gt;(файл, email/флешка)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p2" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="данные для отчетов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="отчеты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="p3" target="fns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n8" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. База 1С в файловом режиме на общем диске - копируется целиком, нет шифрования.&lt;br&gt;2. Реестры на зарплату передаются файлами по почте/на флешке.&lt;br&gt;3. Сканы кадровых документов без разграничения доступа и сроков хранения.&lt;br&gt;4. Нет аудита действий в 1С и на файловом сервере; нет MFA.&lt;br&gt;5. Файловый режим 1С не масштабируется на несколько филиалов." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="900" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-06. Бухгалтерия, кадровый учет и зарплата (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="emp" value="Сотрудник" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="170" height="70" as="geometry"/></mxCell><mxCell id="acc" value="Бухгалтер&lt;br&gt;(VDI, MFA)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="170" height="70" as="geometry"/></mxCell><mxCell id="bank" value="Банк (ДиректБанк)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="275" width="170" height="70" as="geometry"/></mxCell><mxCell id="fns" value="ФНС / СФР&lt;br&gt;(оператор ЭДО)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="590" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P6.1&lt;/b&gt;&lt;br&gt;Кадровый учет&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;1С:ЗУП / Бухгалтерия&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="410" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P6.2&lt;/b&gt;&lt;br&gt;Начисление зарплаты" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="275" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P6.3&lt;/b&gt;&lt;br&gt;Отчетность" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="d8" value='&lt;b&gt;D8&lt;/b&gt;&amp;nbsp;&amp;nbsp;1С (клиент-сервер)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;PostgreSQL, шифрование диска, бэкапы&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="740" width="250" height="54" as="geometry"/></mxCell><mxCell id="dx" value='&lt;b&gt;D9&lt;/b&gt;&amp;nbsp;&amp;nbsp;Кадровый архив (S3, SSE)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;cls:C3 cat:HR,ID, retention&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="822" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="кадровые документы&lt;br&gt;(ЭДО / портал) [М1]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="emp" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="работа в 1С" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="личная карточка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="сканы (шифр.)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="dx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="482"/><mxPoint x="430" y="849"/></Array></mxGeometry></mxCell><mxCell id="e5" value="оклады, табель" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="реестр: TLS + УКЭП [М3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p2" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="данные отчетов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="ЭДО + УКЭП" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p3" target="fns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. 1С переводится в клиент-серверный режим (PostgreSQL), база не доступна как файл, доступ из VDI бухгалтерии.&lt;br&gt;М2. Роли в 1С (кадровик, расчетчик, главбух), MFA, журнал регистрации 1С -&amp;gt; SIEM.&lt;br&gt;М3. Обмен с банком и ФНС только через защищенные каналы (ДиректБанк, ЭДО) с УКЭП, без файлов на флешках.&lt;br&gt;М4. Шифрование дисков и резервных копий, ключи в KMS; сроки хранения кадровых документов по тегам." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="1100" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
