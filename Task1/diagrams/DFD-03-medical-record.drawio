<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-03. Прием у врача и ведение медицинской карты (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="170" height="70" as="geometry"/></mxCell><mxCell id="doc" value="Врач" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="170" height="70" as="geometry"/></mxCell><mxCell id="any" value="Любой сотрудник&lt;br&gt;домена / флешка" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P3.1&lt;/b&gt;&lt;br&gt;Осмотр, сбор анамнеза" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P3.2&lt;/b&gt;&lt;br&gt;Оформление заключения&lt;br&gt;и назначений" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P3.3&lt;/b&gt;&lt;br&gt;Выдача заключения&lt;br&gt;пациенту" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="695" width="200" height="90" as="geometry"/></mxCell><mxCell id="d2" value='&lt;b&gt;D2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Папка Pacient-FIO-BD&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;медкарта: Excel, Word, сканы&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="320" width="250" height="54" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;D5&lt;/b&gt;&amp;nbsp;&amp;nbsp;Journal-Doctor-FIO.xlsx" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="485" width="250" height="54" as="geometry"/></mxCell><mxCell id="d3" value='&lt;b&gt;D3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Exchange&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;письма пациенту&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="710" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="жалобы, анамнез [PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="результаты осмотра" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="doc" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="прошлые записи, анализы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="336"/></Array></mxGeometry></mxCell><mxCell id="e4" value="диагноз, назначения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="заключение (файл) [PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="отметка о приеме" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="заключение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="печать / email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="PDF заключения&lt;br&gt;открытым письмом" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="чтение, копирование на USB,&lt;br&gt;пересылка (нет DLP и аудита)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="any"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1720" y="347"/><mxPoint x="1720" y="890"/><mxPoint x="340" y="890"/><mxPoint x="340" y="835"/></Array></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. Медкарта не структурирована: файлы разных форматов, нет единой карты и версионирования.&lt;br&gt;2. Любой врач (и любой сотрудник с доступом к диску) видит карты всех пациентов - нарушение врачебной тайны (323-ФЗ ст. 13).&lt;br&gt;3. Нет электронной подписи заключений - нельзя доказать авторство и целостность.&lt;br&gt;4. Заключения по email без шифрования, риск ошибки адресата.&lt;br&gt;5. Нет DLP: копирование на USB, печать, пересылка не контролируются.&lt;br&gt;6. Нет сроков хранения и процедуры уничтожения; нет аудита доступа." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="980" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-03. Прием у врача и ведение медицинской карты (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="doc" value="Врач&lt;br&gt;(портал сотрудника)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="170" height="70" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(приложение)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="170" height="70" as="geometry"/></mxCell><mxCell id="gw" value='&lt;b&gt;P3.0&lt;/b&gt;&lt;br&gt;API Gateway + IAM&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;MFA, ABAC [М1]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="pdp" value='&lt;b&gt;P3.1&lt;/b&gt;&lt;br&gt;Policy Decision Point&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;OPA: лечащий врач? [М2]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="200" height="90" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P3.2&lt;/b&gt;&lt;br&gt;Ведение медкарты&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;EMR Service&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;P3.3&lt;/b&gt;&lt;br&gt;Подписание документа&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;УКЭП врача [М4]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="tok" value='&lt;b&gt;P3.4&lt;/b&gt;&lt;br&gt;Шифрование&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Vault Transit [М3]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;EMR DB (PostgreSQL)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;cls:C3 cat:PHI, шифр. полей&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1600" y="290" width="250" height="54" as="geometry"/></mxCell><mxCell id="d2" value='&lt;b&gt;D2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Document Store (S3, SSE)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;подписанные ЭМД, cls:C3&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1600" y="470" width="250" height="54" as="geometry"/></mxCell><mxCell id="d3" value='&lt;b&gt;D3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Audit Log -&amp;gt; SIEM&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;break-glass, массовые чтения&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1600" y="650" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="запрос карты пациента&lt;br&gt;TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="doc" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="мои заключения&lt;br&gt;(только свои)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="решение о доступе" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="pdp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="разрешенный запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="заключение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="PHI поля" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="tok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="шифротекст" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="tok" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="ЭМД + подпись" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1465" y="635"/><mxPoint x="1465" y="508"/></Array></mxGeometry></mxCell><mxCell id="e9" value="решения, break-glass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="pdp" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="347"/><mxPoint x="1510" y="666"/></Array></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. Вход сотрудников только с MFA и с доверенных устройств/VPN; сессии с таймаутом.&lt;br&gt;М2. ABAC (OPA): врач видит карту, только если у него есть активный/недавний визит пациента или направление;&lt;br&gt;      иначе - break-glass с указанием причины и обязательным разбором в SIEM. Пациент видит только свои документы.&lt;br&gt;М3. Шифрование полей PHI (диагноз, анамнез) ключами Vault; ключи раздельно по филиалам; ротация ключей.&lt;br&gt;М4. Заключения подписываются УКЭП врача (целостность, неотказуемость), выдаются через приложение, не по email.&lt;br&gt;М5. DLP на рабочих местах (USB, печать, почта), водяные знаки при печати.&lt;br&gt;М6. Сроки хранения по тегу retention (медкарта - 25 лет), автоматическое уничтожение по истечении." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="1150" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
