<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-04. Анализы и обмен данными с лабораторией (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="doc" value="Врач" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="170" height="70" as="geometry"/></mxCell><mxCell id="pat" value="Пациент" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="170" height="70" as="geometry"/></mxCell><mxCell id="lab" value="Лаборатория&lt;br&gt;(внешняя организация)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="440" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P4.1&lt;/b&gt;&lt;br&gt;Оформление направления" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P4.2&lt;/b&gt;&lt;br&gt;Забор биоматериала" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="515" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P4.3&lt;/b&gt;&lt;br&gt;Передача образцов&lt;br&gt;и бланков в лабораторию" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="440" width="200" height="90" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;P4.4&lt;/b&gt;&lt;br&gt;Прием и раскладка&lt;br&gt;результатов" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="680" width="200" height="90" as="geometry"/></mxCell><mxCell id="d6" value='&lt;b&gt;D6&lt;/b&gt;&amp;nbsp;&amp;nbsp;RegistryByDate.xlsx&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;реестр анализов за день&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="815" width="250" height="54" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;D2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Папка Pacient-FIO-BD" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="815" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="вид анализа, диагноз [PHI]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="doc" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="бланк: ФИО, ДР, диагноз" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="биоматериал" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="пробирки + бланки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="ФИО, ДР, пол, диагноз, телефон&lt;br&gt;[PII][PHI] - курьер / email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p3" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="результаты PDF&lt;br&gt;по email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="строка: ФИО, анализ, результат" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="PDF результатов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="результаты по email /&lt;br&gt;в руки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. Лаборатории передается избыточный набор ПДн (ФИО, телефон, диагноз) - достаточно псевдонима, пола, возраста.&lt;br&gt;2. Нет договора-поручения на обработку ПДн с лабораторией (152-ФЗ ст. 6 ч. 3), нет контроля ее мер защиты.&lt;br&gt;3. Результаты приходят и уходят по открытой почте; возможна подмена/ошибка адресата.&lt;br&gt;4. Реестр за день содержит результаты всех пациентов в одном файле.&lt;br&gt;5. Ручное сопоставление результатов с пациентом - риск положить анализ не в ту карту." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1000" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-04. Анализы и обмен данными с лабораторией через API (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="doc" value="Врач" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="170" height="70" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(приложение)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="170" height="70" as="geometry"/></mxCell><mxCell id="lab" value="Лаборатория&lt;br&gt;(API партнера)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1720" y="440" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P4.1&lt;/b&gt;&lt;br&gt;Электронное направление&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;EMR Service&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;P4.2&lt;/b&gt;&lt;br&gt;Псевдонимизация заказа&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Lab Integration Service [М2]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="gw" value='&lt;b&gt;P4.3&lt;/b&gt;&lt;br&gt;Partner API Gateway&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;mTLS, OAuth2, схема [М1]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1270" y="440" width="200" height="90" as="geometry"/></mxCell><mxCell id="p4" value='&lt;b&gt;P4.4&lt;/b&gt;&lt;br&gt;Прием результатов&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Lab Integration Service&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="620" width="200" height="90" as="geometry"/></mxCell><mxCell id="p5" value='&lt;b&gt;P4.5&lt;/b&gt;&lt;br&gt;Публикация в медкарту&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;EMR + Notification&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="620" width="200" height="90" as="geometry"/></mxCell><mxCell id="ordmap" value='&lt;b&gt;D7&lt;/b&gt;&amp;nbsp;&amp;nbsp;Order Map (Vault)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;order_id &amp;lt;-&amp;gt; patient_token&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="850" y="455" width="250" height="54" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;EMR DB&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;результаты, cls:C3 PHI&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="815" width="250" height="54" as="geometry"/></mxCell><mxCell id="au" value="&lt;b&gt;D4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Audit Log -&amp;gt; SIEM" style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1270" y="815" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="код анализа" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="doc" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="направление" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="ordmap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="order_id, штрихкод, пол,&lt;br&gt;возраст (лет), коды тестов&lt;br&gt;(без ФИО) [М2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="POST /orders&lt;br&gt;mTLS, ГОСТ TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="gw" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="POST /results/{order_id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1805" y="552"/></Array></mxGeometry></mxCell><mxCell id="e7" value="результат (валидирован&lt;br&gt;по схеме) [М3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="patient_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ordmap" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="результат + токен" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="запись (шифр.)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value='push: "результаты готовы"&lt;br&gt;(без содержания) [М4]' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="все вызовы API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="au"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. Партнерский шлюз: mTLS + OAuth2 client credentials, scope на операции, rate limit, allow-list IP, версия контракта.&lt;br&gt;М2. Контракт API по умолчанию не содержит прямых идентификаторов: только order_id и обезличенные атрибуты.&lt;br&gt;      Поля в OpenAPI размечены x-data-class; линтер в CI запрещает поля cls:C3 в партнерских контрактах.&lt;br&gt;М3. Защита от BOLA/IDOR: лаборатория может писать только в свои order_id; пациент читает только свои результаты.&lt;br&gt;М4. Уведомления без медицинского содержания; просмотр результатов - только в приложении после входа.&lt;br&gt;М5. Договор-поручение с лабораторией (152-ФЗ ст. 6), локализация данных в РФ, аудит вызовов и алерты." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1150" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
