<mxfile host="drawio" type="device"><diagram name="As-Is" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-05. Оплата медицинских услуг (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;красная стрелка - поток с ПДн / мед. данными без защиты&lt;br&gt;серая стрелка - прочие данные&lt;br&gt;Теги: [PII] персональные данные, [PHI] данные о здоровье&lt;br&gt;(спец. категория, врачебная тайна), [FIN] платежные,&lt;br&gt;[HR] кадровые, [ID] документы, удостоверяющие личность" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="170" height="70" as="geometry"/></mxCell><mxCell id="bank" value="Банк-эквайер&lt;br&gt;(POS-терминал)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="505" y="770" width="170" height="70" as="geometry"/></mxCell><mxCell id="ofd" value="ОФД / ФНС" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1540" y="582" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;P5.1&lt;/b&gt;&lt;br&gt;Прием оплаты (кассир)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="425" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;P5.2&lt;/b&gt;&lt;br&gt;Двойной учет в Excel" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;P5.3&lt;/b&gt;&lt;br&gt;Фискализация (ККМ)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="575" width="200" height="90" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;P5.4&lt;/b&gt;&lt;br&gt;Процессинг платежей&lt;br&gt;(бухгалтерия)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1540" y="425" width="200" height="90" as="geometry"/></mxCell><mxCell id="d7" value='&lt;b&gt;D7&lt;/b&gt;&amp;nbsp;&amp;nbsp;Payments.xlsx&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;общий диск&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="245" width="250" height="54" as="geometry"/></mxCell><mxCell id="d8" value='&lt;b&gt;D8&lt;/b&gt;&amp;nbsp;&amp;nbsp;1С:Бухгалтерия (файл .1CD)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;общий диск, файловый режим&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="770" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="ФИО, перечень услуг [PII][PHI]&lt;br&gt;наличные / карта [FIN]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="данные карты&lt;br&gt;(в терминале)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="ФИО, услуги, сумма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="строка оплаты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="услуги, сумма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="оплата [TCP/IP - OLE]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1" source="p3" target="d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="чек: наименования услуг&lt;br&gt;(раскрывают характер лечения)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="ofd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="чек" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="чек" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="выписки, сверка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1730" y="797"/></Array></mxGeometry></mxCell><mxCell id="e11" value="сверка с Excel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#C0392B;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d7" target="p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="272"/></Array></mxGeometry></mxCell><mxCell id="n12" value="&lt;b&gt;Проблемы (As-Is)&lt;/b&gt;&lt;br&gt;1. Двойной ручной учет (Excel + 1С): расхождения, ошибки, лишняя копия ПДн.&lt;br&gt;2. Перечень услуг вместе с ФИО раскрывает сведения о здоровье (врачебная тайна).&lt;br&gt;3. 1С в файловом режиме: файл базы на общем диске можно скопировать целиком.&lt;br&gt;4. Нет разграничения доступа к Payments.xlsx и аудита.&lt;br&gt;5. Невозможна онлайн-оплата из портала/приложения - блокер целевого процесса." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="900" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="To-Be" id="diagram-page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD-05. Оплата медицинских услуг через платежный шлюз (To-Be)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения (нотация Gane-Sarson):&lt;br&gt;прямоугольник - внешняя сущность&lt;br&gt;скругленный блок - процесс / сервис&lt;br&gt;открытый блок - хранилище данных&lt;br&gt;зеленая стрелка - защищенный поток с ПДн&lt;br&gt;серая стрелка - поток без ПДн или с токенами&lt;br&gt;Теги классификации: cls:C1 internal, C2 confidential,&lt;br&gt;C3 restricted; cat:PII / PHI / FIN / ID / HR&lt;br&gt;[Мn] - мера защиты из списка внизу диаграммы" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="20" width="430" height="175" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(приложение)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="170" height="70" as="geometry"/></mxCell><mxCell id="cash" value="Кассир&lt;br&gt;(касса филиала)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="170" height="70" as="geometry"/></mxCell><mxCell id="acq" value="Банк-эквайер&lt;br&gt;(платежная страница)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1720" y="305" width="170" height="70" as="geometry"/></mxCell><mxCell id="ofd" value="ОФД / ФНС" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="800" width="170" height="70" as="geometry"/></mxCell><mxCell id="gw" value='&lt;b&gt;P5.0&lt;/b&gt;&lt;br&gt;API Gateway + IAM&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;[М1]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="200" height="90" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b&gt;P5.1&lt;/b&gt;&lt;br&gt;Платежный шлюз&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Payment Service [М2]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="305" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b&gt;P5.2&lt;/b&gt;&lt;br&gt;Фискализация&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Fiscal adapter (54-ФЗ)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value='&lt;b&gt;P5.3&lt;/b&gt;&lt;br&gt;Интеграция с 1С&lt;br&gt;&lt;font style="font-size:9px" color="#1f3d7a"&gt;Accounting Adapter [М4]&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1270" y="770" width="200" height="90" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Payment DB&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;invoice, patient_token, сумма, cls:C2 FIN&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1270" y="455" width="250" height="54" as="geometry"/></mxCell><mxCell id="d8" value='&lt;b&gt;D8&lt;/b&gt;&amp;nbsp;&amp;nbsp;1С:Бухгалтерия (клиент-сервер)&lt;br&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;PostgreSQL, шифрование диска&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=partialRectangle;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1660" y="792" width="250" height="54" as="geometry"/></mxCell><mxCell id="e1" value="оплата счета" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="оплата на кассе" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cash" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="invoice_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="redirect на страницу банка;&lt;br&gt;PAN не попадает в систему [М2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;" edge="1" parent="1" source="p1" target="acq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="статус + токен карты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="acq" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1805" y="415"/></Array></mxGeometry></mxCell><mxCell id="e6" value="платеж" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="сумма, код услуги" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value='чек: "Медицинские услуги по&lt;br&gt;договору N" [М3]' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#2D7D46;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="ofd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="агрегаты платежей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="проводки: договор, сумма,&lt;br&gt;обобщенный код услуги" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;Меры защиты (To-Be)&lt;/b&gt;&lt;br&gt;М1. Доступ к платежам по ролям: кассир - свой филиал, бухгалтер - агрегаты; MFA, аудит в SIEM.&lt;br&gt;М2. Платежная страница эквайера + токенизация карт: данные карт не хранятся и не обрабатываются (сокращение области PCI DSS).&lt;br&gt;М3. В чеке и в 1С - обобщенные наименования услуг без указания на диагноз; e-mail для чека только по согласию.&lt;br&gt;М4. Единый источник платежей (Payment DB) -&amp;gt; 1С через адаптер, двойной учет в Excel исключен.&lt;br&gt;М5. 1С переводится в клиент-серверный режим, база не доступна как файл; бэкапы шифруются." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1150" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
