<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device"><diagram name="C2 Classification Engine" id="diagram-page-0"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 Level 2 (C2). Движок классификации данных перед пакетной загрузкой в аналитическое хранилище" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения:&lt;br&gt;синий - контейнер движка&lt;br&gt;зеленый - контейнер защиты / Privacy by Design&lt;br&gt;серый - внешняя система&lt;br&gt;пунктир - метаданные, события, метрики&lt;br&gt;cls:C0-C3 - класс конфиденциальности" style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2150" y="20" width="400" height="125" as="geometry"/></mxCell><mxCell id="x_src" value='&lt;b style="font-size:13px"&gt;Операционные системы&lt;/b&gt;&lt;br&gt;[PostgreSQL: Patient, Appointment, EMR, Payment]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Выгрузки по расписанию / CDC-снимки&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="300" height="115" as="geometry"/></mxCell><mxCell id="x_xls" value='&lt;b style="font-size:13px"&gt;Legacy-источники&lt;/b&gt;&lt;br&gt;[Excel, CSV, выгрузки 1С]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Структуры меняются, разметки нет&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="260" height="115" as="geometry"/></mxCell><mxCell id="u_ds" value='&lt;b style="font-size:13px"&gt;Data Steward&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Ручная проверка спорных колонок&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1300" y="80" width="160" height="150" as="geometry"/></mxCell><mxCell id="u_dpo" value='&lt;b style="font-size:13px"&gt;DPO / ИБ&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#dddddd"&gt;Политики, отчеты&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=mxgraph.c4.person2;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="80" width="160" height="150" as="geometry"/></mxCell><mxCell id="bnd" value="&lt;b&gt;Classification Engine&lt;/b&gt;&lt;br&gt;[Container boundary, Kubernetes]" style="rounded=1;arcSize=3;absoluteArcSize=0;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="2000" height="1020" as="geometry"/></mxCell><mxCell id="c_orch" value='&lt;b style="font-size:13px"&gt;Ingestion Orchestrator&lt;/b&gt;&lt;br&gt;[Container: Apache Airflow]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Расписание пакетов, ретраи, backfill; каждый пакет -&amp;gt; landing&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="d_land" value='&lt;b style="font-size:13px"&gt;Landing / Quarantine Zone&lt;/b&gt;&lt;br&gt;[S3 (MinIO), SSE-KMS]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Неразмеченные пакеты; доступ только движку; TTL 7 дней&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_schema" value='&lt;b style="font-size:13px"&gt;Schema Inference &amp;amp; Drift Detector&lt;/b&gt;&lt;br&gt;[Container: Spark on K8s]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Выводит схему, сравнивает с реестром: новые / измененные / удаленные колонки&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="d_reg" value='&lt;b style="font-size:13px"&gt;Schema &amp;amp; Classification Registry&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Версии схем, fingerprint колонок, классы, история решений&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_prof" value='&lt;b style="font-size:13px"&gt;Sampler &amp;amp; Profiler&lt;/b&gt;&lt;br&gt;[Container: Spark on K8s]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Стратифицированная выборка, статистики, форматы, кардинальность&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="240" height="115" as="geometry"/></mxCell><mxCell id="q_jobs" value='&lt;b style="font-size:13px"&gt;Classification Jobs&lt;/b&gt;&lt;br&gt;[Kafka topic]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Задачи только по новым / измененным колонкам&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;direction=south;size=10;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="575" width="240" height="90" as="geometry"/></mxCell><mxCell id="c_rules" value='&lt;b style="font-size:13px"&gt;Rule &amp;amp; Dictionary Detectors&lt;/b&gt;&lt;br&gt;[Container: Python workers (KEDA)]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Regex + контрольные суммы: телефон, email, СНИЛС, ИНН, паспорт, карта (Luhn); словари: ФИО, МКБ-10, лекарства&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="560" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_ml" value='&lt;b style="font-size:13px"&gt;ML Classifier (NER + column model)&lt;/b&gt;&lt;br&gt;[Container: Model Serving (KServe / MLflow)]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;NER для свободного текста (диагнозы, анамнез); модель по имени и профилю колонки&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="560" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_dec" value='&lt;b style="font-size:13px"&gt;Decision Service&lt;/b&gt;&lt;br&gt;[Container: Java + OPA]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Ансамбль скоров -&amp;gt; cls / cat / prot; порог уверенности; неизвестное -&amp;gt; C3 по умолчанию&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_ui" value='&lt;b style="font-size:13px"&gt;Steward Console&lt;/b&gt;&lt;br&gt;[Container: Web UI]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Очередь спорных колонок, подтверждение / исправление (обратная связь для ML)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1580" y="560" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_tag" value='&lt;b style="font-size:13px"&gt;Tag Publisher&lt;/b&gt;&lt;br&gt;[Container: Java]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Публикует теги в каталог, генерирует политики доступа и маскирования&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="800" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_prot" value='&lt;b style="font-size:13px"&gt;Protection Applier&lt;/b&gt;&lt;br&gt;[Container: Spark on K8s]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;По тегам: шифрование полей, токенизация, маскирование, удаление запрещенных полей&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="800" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_load" value='&lt;b style="font-size:13px"&gt;Layer Router &amp;amp; Loader&lt;/b&gt;&lt;br&gt;[Container: Spark on K8s]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Направляет данные в слой по классу; пакет без полной классификации не грузится&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="800" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_metrics" value='&lt;b style="font-size:13px"&gt;Quality &amp;amp; Metrics Exporter&lt;/b&gt;&lt;br&gt;[Container: Python]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Precision / recall по выборке ручной проверки, покрытие, latency, backlog&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1280" y="800" width="240" height="115" as="geometry"/></mxCell><mxCell id="c_fb" value='&lt;b style="font-size:13px"&gt;Feedback &amp;amp; Retraining&lt;/b&gt;&lt;br&gt;[Container: MLflow pipelines]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Переобучение моделей и обновление правил по решениям Data Steward&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1580" y="800" width="240" height="115" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Поток обработки пакета&lt;/b&gt;&lt;br&gt;1. Orchestrator забирает пакет из источника и кладет в Landing / Quarantine (данные еще не размечены и недоступны пользователям).&lt;br&gt;2. Schema Detector выводит схему пакета и сравнивает fingerprint колонок с реестром: известные колонки берут класс из реестра,&lt;br&gt;    новые / измененные (структурные изменения источника) отправляются на классификацию.&lt;br&gt;3. Sampler формирует выборку значений и профиль колонки; задачи ставятся в Kafka; Rule / Dictionary и ML-детекторы работают параллельно.&lt;br&gt;4. Decision Service объединяет скоры, применяет политики (OPA): уверенность &amp;gt;= порога -&amp;gt; тег; ниже порога -&amp;gt; C3 и очередь Data Steward.&lt;br&gt;5. Tag Publisher записывает теги в каталог и реестр; Protection Applier шифрует / токенизирует / маскирует поля согласно тегам.&lt;br&gt;6. Loader направляет данные в слои хранилища по классу; события классификации и метрики уходят в мониторинг и SIEM.&lt;br&gt;7. Решения Data Steward возвращаются в Feedback &amp;amp; Retraining - модели и правила улучшаются, доля ручной проверки снижается." style="whiteSpace=wrap;html=1;fontSize=11;shape=note;size=12;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="1940" height="230" as="geometry"/></mxCell><mxCell id="b_dwh" value="&lt;b&gt;Аналитическое хранилище (слои)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;dashPattern=4 4;fillColor=#f9fbff;strokeColor=#6c8ebf;fontColor=#1f3d7a;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="2080" y="280" width="480" height="760" as="geometry"/></mxCell><mxCell id="d_l1r" value='&lt;b style="font-size:13px"&gt;L1-R Restricted Vault&lt;/b&gt;&lt;br&gt;[S3 + ClickHouse, отдельный контур]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;C3: PHI, ID; шифрование полей; доступ - только ETL и break-glass&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2120" y="330" width="400" height="100" as="geometry"/></mxCell><mxCell id="d_l1" value='&lt;b style="font-size:13px"&gt;L1 Raw Confidential&lt;/b&gt;&lt;br&gt;[S3, SSE-KMS]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;C2: контакты, платежи; доступ - Data Engineers&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2120" y="460" width="400" height="100" as="geometry"/></mxCell><mxCell id="d_l2" value='&lt;b style="font-size:13px"&gt;L2 Curated (псевдонимы)&lt;/b&gt;&lt;br&gt;[ClickHouse]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Токены вместо идентификаторов, row / column policy&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#3E9E5B;strokeColor=#2D7D46;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2120" y="590" width="400" height="100" as="geometry"/></mxCell><mxCell id="d_l3" value='&lt;b style="font-size:13px"&gt;L3 Marts (обезличенные)&lt;/b&gt;&lt;br&gt;[ClickHouse]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;C0-C1: агрегаты, k &amp;gt;= 5; BI, ML, LLM&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;size=10;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2120" y="720" width="400" height="100" as="geometry"/></mxCell><mxCell id="x_cat" value='&lt;b style="font-size:13px"&gt;Data Catalog + Lineage&lt;/b&gt;&lt;br&gt;[OpenMetadata]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Теги, владельцы, lineage&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2120" y="860" width="190" height="110" as="geometry"/></mxCell><mxCell id="x_vault" value='&lt;b style="font-size:13px"&gt;Vault / Tokenization&lt;/b&gt;&lt;br&gt;[KMS]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Ключи, токены&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2330" y="860" width="190" height="110" as="geometry"/></mxCell><mxCell id="x_mon" value='&lt;b style="font-size:13px"&gt;Мониторинг и SIEM&lt;/b&gt;&lt;br&gt;[VictoriaMetrics, vmalert, Elastic]&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#eeeeee"&gt;Метрики качества, алерты, аудит&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="2120" y="1080" width="400" height="110" as="geometry"/></mxCell><mxCell id="e1" value='пакеты&lt;br&gt;&lt;font color="#555555"&gt;[JDBC / снимки]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_src" target="c_orch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value='файлы&lt;br&gt;&lt;font color="#555555"&gt;[SFTP / S3]&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_xls" target="c_orch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[S3 / TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c_orch" target="d_land"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=10;fontSize=10;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;ju